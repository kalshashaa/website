---
import { localizeCopy, type SiteContent } from '../cms/content';
import { type Locale } from '../content/site';
import PageIntro from './PageIntro.astro';
import ProjectGrid from './ProjectGrid.astro';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
interface Props { content: SiteContent; locale: Locale; }
const { locale, content } = Astro.props;
const t = localizeCopy(content, locale);
const { company } = content;

---
<PageIntro locale={locale} title={t('أعالي الجزيرة. اهتمام بالمكان.', 'Aali Aljazerah. Care for the place.')} description={t('شركة مقاولات تأسست عام 1991، تقدّم خدماتها للشركات والمؤسسات في المملكة العربية السعودية.', 'A contracting company founded in 1991, serving businesses and institutions in Saudi Arabia.')}/>
<section class="section"><div class="container about-intro-grid"><h2>{t('نعتني بتفاصيل منشأتك ومتطلبات أعمالك.', 'Attention to your facility and the work it needs.')}</h2><div><p class="lead">{company.introduction[locale]}</p><p>{t('تتنوع أعمالنا بين عقود الصيانة المصممة بحسب الاحتياج، وأعمال التطوير والديكور، وإنشاء المستودعات وغرف الساندوتش بانل والحدائق، والتكييف والتوريد والأعمال الفنية المساندة.', 'Our work spans tailored maintenance contracts, refurbishment and interiors, warehouse and sandwich-panel room construction, garden works, air conditioning, supply and supporting technical services.')}</p><p>{t('نخدم منشآت الأعمال في المناطق الوسطى والغربية والشرقية، ونبدأ بفهم الموقع ومتطلباته لتحديد نطاق التنفيذ المناسب.', 'We work in the Central, Western and Eastern regions, beginning with an understanding of each site to establish an appropriate scope.')}</p></div></div></section>
<section class="section values-section"><div class="container values-grid"><article><span class="value-symbol" aria-hidden="true"><Icon name="building" size={36}/></span><h2>{t('رؤيتنا', 'Our vision')}</h2><p>{t('أن نكون جهة يعتمد عليها عملاؤنا في العناية بمنشآتهم وتطويرها، من خلال أعمال تراعي احتياجات المكان وجودة استخدامه.', 'To be a dependable partner in the care and development of our clients’ facilities, with work that responds to the needs and use of each place.')}</p></article><article><span class="value-symbol" aria-hidden="true"><Icon name="tools" size={36}/></span><h2>{t('رسالتنا', 'Our mission')}</h2><p>{t('تقديم خدمات مقاولات وصيانة وتوريد بنطاق واضح وتنفيذ مسؤول، مع الاهتمام بالتفاصيل التي تساعد المنشأة على أداء عملها.', 'To deliver contracting, maintenance and supply with a clear scope, responsible execution and attention to the details that support a facility’s operation.')}</p></article></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="section-kicker">{t('طريقة العمل', 'Our approach')}</p><h2>{t('نبدأ بما يحتاجه الموقع.', 'Start with what the site needs.')}</h2></div><p>{t('في عقود الصيانة، نراجع عمر المبنى ومساحته وعدد الوحدات ومتطلباته قبل إعداد العقد.', 'For maintenance contracts, we review the building age, area, unit count and requirements before preparing the scope.')}</p></div><ol class="process-list"><li><span>1</span><div><h3>{t('فهم الاحتياج', 'Understand the requirement')}</h3><p>{t('مناقشة المطلوب وطبيعة المنشأة.', 'Discuss the work required and the nature of the facility.')}</p></div></li><li><span>2</span><div><h3>{t('المعاينة والتقييم', 'Assess the site')}</h3><p>{t('زيارة الموقع وتقييم عناصره ومتطلباته.', 'Visit the site and review its conditions and requirements.')}</p></div></li><li><span>3</span><div><h3>{t('تحديد نطاق العمل', 'Define the scope')}</h3><p>{t('إعداد الأعمال المناسبة للاحتياج الذي تمت مراجعته.', 'Prepare an appropriate scope based on the reviewed needs.')}</p></div></li></ol></div></section>
<section class="section projects-section"><div class="container"><div class="section-heading"><div><p class="section-kicker">{t('من أعمال الشركة', 'Company portfolio')}</p><h2>{t('أعمال متنوعة، في مواقع فعلية.', 'Different scopes. Real places.')}</h2></div><p>{t('صور ووصف للأعمال المنفذة، كما وثقها بروفايل الشركة.', 'Project photographs and work descriptions documented in the company profile.')}</p></div><ProjectGrid content={content} locale={locale} detailed/></div></section>
<ContactLink content={content} locale={locale}/>
